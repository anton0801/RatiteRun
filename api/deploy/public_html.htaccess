# ---------------------------------------------------------------------------
# RatiteRun — .htaccess для public_html
#
# Кладётся в public_html/ и ПЕРЕИМЕНОВЫВАЕТСЯ в .htaccess (с точкой),
# когда каталог приложения лежит внутри public_html:
#
#   public_html/
#   ├── .htaccess          <- этот файл
#   └── api/
#       ├── public/index.php
#       ├── src/  bin/  migrations/  storage/
#       └── .env
#
# Делает две вещи:
#   1. Отправляет все запросы во входную точку приложения.
#   2. Закрывает от прямого доступа всё остальное. Это здесь не «на всякий
#      случай»: при такой раскладке .env, storage/ и src/ физически лежат
#      внутри корня сайта, и только эти правила мешают скачать их по HTTP.
#
# Если каталог приложения назван не "api" — замените слово в трёх местах ниже.
#
# API_BASE_PATH в .env остаётся ПУСТЫМ: перенаправление внутреннее,
# REQUEST_URI не меняется, приложение видит исходный путь.
# ---------------------------------------------------------------------------

Options -Indexes +FollowSymLinks
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # -----------------------------------------------------------------------
    # 1. Проверка сертификата — пропускаем раньше всех запретов
    # -----------------------------------------------------------------------
    RewriteRule ^\.well-known/ - [L]

    # -----------------------------------------------------------------------
    # 2. Запреты
    #
    # Сверяемся с THE_REQUEST, а не с текущим URI. THE_REQUEST — это исходная
    # строка запроса от браузера, и она НЕ меняется при внутреннем
    # перенаправлении. Если проверять текущий URI, то правило сработает уже
    # на нашем же перенаправлении в api/public/index.php и вернёт 403 на всё.
    # -----------------------------------------------------------------------

    # Прямое обращение в каталог приложения мимо public/:
    # .env, src/, bin/, migrations/, storage/, install.sql
    #
    # Сам api/public/ отсюда закрыть нельзя: в нём лежит собственный
    # .htaccess, а правила mod_rewrite в подкаталог с .htaccess не
    # наследуются. Это безвредно — там только точка входа, и прямое
    # обращение к ней отдаёт обычный 404 приложения.
    # Важно другое: setup-check.php и whereami.php оттуда надо удалить,
    # они доступны по прямой ссылке.
    RewriteCond %{THE_REQUEST} \s/+api/ [NC]
    RewriteCond %{THE_REQUEST} !\s/+api/public/ [NC]
    RewriteRule ^ - [F,L]

    # Точечные файлы где угодно (.env, .git, .htpasswd), кроме .well-known
    RewriteRule (^|/)\.(?!well-known) - [F,L]

    # Служебные расширения, если что-то положили рядом по ошибке
    RewriteRule \.(sql|log|ini|sh|bak|swp|dist|lock)$ - [F,L]

    # -----------------------------------------------------------------------
    # 3. Маршрутизация
    # -----------------------------------------------------------------------

    # Корень сайта. Отдельным правилом: общее правило ниже отсекает каталоги,
    # а корень — это каталог, и без этой строки главная отдавала бы 403.
    RewriteRule ^$ api/public/index.php [QSA,L]

    # Всё остальное, чему не соответствует реальный файл или каталог.
    # Проверка на существование обязательна: после перенаправления цель
    # становится существующим файлом, условие перестаёт выполняться,
    # и правило не зацикливается само на себе.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ api/public/index.php [QSA,L]

    # -----------------------------------------------------------------------
    # 4. Заголовок Authorization доходит до PHP не всегда — пробрасываем сами
    # -----------------------------------------------------------------------
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# ---------------------------------------------------------------------------
# Запрет по имени файла — дублирует правила выше на случай,
# если mod_rewrite окажется отключён
# ---------------------------------------------------------------------------

<FilesMatch "^\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "\.(sql|log|ini|sh|bak|swp|dist|lock|md|yaml|yml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ---------------------------------------------------------------------------
# Заголовки. Основные ставит PHP, но эти нужны и на ответах 403,
# которые до PHP не доходят.
# ---------------------------------------------------------------------------

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always unset X-Powered-By
</IfModule>

# ---------------------------------------------------------------------------
# Загрузка фото: до 12 МБ. На LiteSpeed (Hostinger) эти директивы обычно
# игнорируются — лимит там задаётся в панели, раздел PHP Configuration.
# ---------------------------------------------------------------------------

<IfModule mod_php.c>
    php_flag display_errors off
    php_value upload_max_filesize 12M
    php_value post_max_size 13M
</IfModule>

ServerSignature Off
