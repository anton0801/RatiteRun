# Скопировать в .env и заполнить. .env не коммитить.

APP_ENV=production
APP_DEBUG=false

# Домен, на котором живут API и страницы
APP_HOST=ratiterun.online

# Путь, по которому API смонтирован. Пусто, если это корень домена.
# Например, при размещении в /api указать API_BASE_PATH=/api
API_BASE_PATH=

# Отказ обслуживать незашифрованные соединения. Выключать только
# для локальной разработки без TLS.
FORCE_HTTPS=true
ALLOW_INSECURE_COOKIES=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ratiterun
DB_USER=ratiterun
DB_PASS=

# Обязательно. Сгенерировать: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
JWT_ACCESS_TTL=3600
REFRESH_TTL_DAYS=90

# Bundle ID приложения — проверяется как aud в Apple identity token
APPLE_BUNDLE_ID=com.runnedratite.RatiteRun

# Куда класть фото, PDF-отчёты и кэш ключей Apple
STORAGE_PATH=/var/www/ratiterun/storage

REPORT_TTL_DAYS=30

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_PER_IP_PER_MINUTE=600

# Через запятую, для веб-клиента. Мобильному приложению не нужно.
CORS_ORIGINS=
